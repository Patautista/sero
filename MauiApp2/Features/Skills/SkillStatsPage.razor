@page "/skills"
@using Domain.Shared.Models
@using MauiApp2.Features.Onboarding
@using MauiApp2.Features.Skills
@inject OnboardingService OnboardingService
@inject ISkillAreaCatalogProvider SkillAreaCatalogProvider
@inject NavigationManager Navigation

<div class="skill-stats-page">
    <div class="skill-stats-header">
        <button class="back-button" @onclick="GoBack">←</button>
        <div>
            <h2>Skill Stats</h2>
            <p class="skill-stats-subtitle">Track your broad language skills and concept progress path.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="skill-stats-state">Loading your progress...</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="skill-stats-state skill-stats-error">@errorMessage</div>
    }
    else
    {
        <section class="skill-summary-card">
            <div>
                <div class="skill-summary-label">Overall progress</div>
                <div class="skill-summary-value">@overallScore/100</div>
            </div>
            <div class="skill-summary-meta">
                <span>@masteredCount mastered areas</span>
                @if (!string.IsNullOrWhiteSpace(weakestSkillName))
                {
                    <span>Weakest skill: @weakestSkillName</span>
                }
            </div>
        </section>

        <section class="skill-section">
            <div class="skill-section-header">
                <h3>Core skills</h3>
                <span class="skill-section-caption">Reading, writing, and listening</span>
            </div>
            <div class="skill-card-grid">
                @foreach (var card in skillCards)
                {
                    <article class="skill-card">
                        <div class="skill-card-header">
                            <h4>@card.Name</h4>
                            <span class="skill-card-score">@card.Score/100</span>
                        </div>
                        <div class="skill-progress-track">
                            <div class="skill-progress-fill" style="width: @card.Score%;"></div>
                        </div>
                        <div class="skill-card-level">@card.Level</div>
                    </article>
                }
            </div>
        </section>

        <section class="skill-section">
            <div class="skill-section-header">
                <h3>Next up</h3>
                <span class="skill-section-caption">Unlocked areas you can focus on next</span>
            </div>
            @if (frontierAreas.Count == 0)
            {
                <div class="skill-empty-state">No frontier areas yet.</div>
            }
            else
            {
                <div class="frontier-grid">
                    @foreach (var area in frontierAreas)
                    {
                        <article class="frontier-card">
                            <div class="frontier-card-top">
                                <span class="area-kind-pill">@FormatCategory(area.Category)</span>
                                <span class="stage-pill">Stage @area.Stage</span>
                            </div>
                            <h4>@area.Name</h4>
                            <div class="skill-progress-track compact">
                                <div class="skill-progress-fill" style="width: @area.Score%;"></div>
                            </div>
                            <div class="frontier-meta">@area.Score/100</div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="skill-section">
            <div class="skill-section-header">
                <h3>Skill areas</h3>
                <span class="skill-section-caption">Organized by learning path</span>
            </div>
            @if (categoryGroups.Count == 0)
            {
                <div class="skill-empty-state">No skill areas found for this language.</div>
            }
            else
            {
                @foreach (var category in categoryGroups)
                {
                    <div class="stage-group">
                        <div class="stage-group-header">
                            <h4>@FormatCategory(category.Category)</h4>
                            <span>@category.MasteredCount / @category.Areas.Count mastered</span>
                        </div>
                        <div class="area-list">
                            @foreach (var area in category.Areas)
                            {
                                <article class="area-row @(area.IsMastered ? "mastered" : string.Empty)">
                                    <div class="area-row-main">
                                        <div class="area-row-title-wrap">
                                            <h5>@area.Name</h5>
                                            @if (area.IsMastered)
                                            {
                                                <span class="mastered-pill">Mastered</span>
                                            }
                                        </div>
                                        <span class="area-row-score">@area.Score/100 · Stage @area.Stage</span>
                                    </div>
                                    <div class="skill-progress-track compact">
                                        <div class="skill-progress-fill" style="width: @area.Score%;"></div>
                                    </div>
                                    @if (area.Prerequisites.Count > 0)
                                    {
                                        <div class="area-row-prereqs">Needs: @string.Join(", ", area.Prerequisites)</div>
                                    }
                                </article>
                            }
                        </div>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int overallScore;
    private int masteredCount;
    private string weakestSkillName = string.Empty;
    private List<SkillScoreCard> skillCards = new();
    private List<AreaProgressCard> frontierAreas = new();
    private List<SkillAreaCategoryGroup> categoryGroups = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userProfile = await OnboardingService.GetCurrentUserProfileAsync();
            if (userProfile is null)
            {
                errorMessage = "No learner profile found yet.";
                return;
            }

            var catalog = await SkillAreaCatalogProvider.GetCatalogAsync();
            var skills = userProfile.Skills;
            var areaProgress = userProfile.AreaProgress;

            overallScore = (int)Math.Round(skills.AverageScore);
            var applicableAreas = catalog.ApplicableTo(userProfile.TargetLanguage);
            masteredCount = applicableAreas.Count(area => areaProgress.IsMastered(area.Id));
            weakestSkillName = skills.WeakestSkill?.ToString() ?? string.Empty;

            skillCards = SkillProfile.AllSkills
                .Select(skill => new SkillScoreCard(
                    skill.ToString(),
                    skills[skill],
                    DescribeLevel(skills[skill])))
                .OrderByDescending(card => card.Score)
                .ToList();

            frontierAreas = areaProgress.GetFrontier(catalog, userProfile.TargetLanguage, take: 6)
                .Select(area => ToAreaCard(area, areaProgress, catalog))
                .ToList();

            categoryGroups = applicableAreas
                .GroupBy(area => area.Category, StringComparer.OrdinalIgnoreCase)
                .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
                .Select(group => new SkillAreaCategoryGroup(
                    group.Key,
                    group.OrderBy(area => area.Stage)
                        .ThenBy(area => area.Name, StringComparer.OrdinalIgnoreCase)
                        .Select(area => ToAreaCard(area, areaProgress, catalog))
                        .ToList()))
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load skill stats: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static AreaProgressCard ToAreaCard(
        SkillArea area,
        AreaProgress progress,
        SkillAreaCatalog catalog) =>
        new(
            area.Id,
            area.Name,
            area.Category,
            area.Stage,
            progress[area.Id],
            progress.IsMastered(area.Id),
            area.Prerequisites
                .Select(id => catalog.Find(id)?.Name ?? id)
                .ToList());

    private static string DescribeLevel(int score) => score switch
    {
        >= 80 => "Very comfortable",
        >= 60 => "Comfortable",
        >= 40 => "Developing",
        >= 20 => "Shaky",
        _ => "Just starting"
    };

    private static string FormatCategory(string category) => string.Join(" ", category
        .Split('-', StringSplitOptions.RemoveEmptyEntries)
        .Select(word => char.ToUpperInvariant(word[0]) + word[1..]));

    private void GoBack() => Navigation.NavigateTo("/home");

    private sealed record SkillScoreCard(string Name, int Score, string Level);

    private sealed record AreaProgressCard(
        string Id,
        string Name,
        string Category,
        int Stage,
        int Score,
        bool IsMastered,
        List<string> Prerequisites);

    private sealed record SkillAreaCategoryGroup(string Category, List<AreaProgressCard> Areas)
    {
        public int MasteredCount => Areas.Count(area => area.IsMastered);
    }
}
