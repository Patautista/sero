@page "/home"
@using MauiApp2.Features.QuickActions
@using MauiApp2.Features.Onboarding
@using MauiApp2.Components
@using MauiApp2.Components.Buttons
@using Domain.Shared.Models
@using Business.Interfaces
@using Infrastructure.Factories
@using MauiApp2.Services.Audio
@inherits SharedBaseComponent
@inject QuickActionsService QuickActionsService
@inject OnboardingService OnboardingService
@inject NavigationManager Navigation

<div class="home-container">
    <div class="header">
        <div class="companion-section">
            <div class="companion-avatar">
                @if (!string.IsNullOrEmpty(companionAvatarImagePath))
                {
                    <img src="@companionAvatarImagePath" alt="@companionName" class="w-16 h-16 rounded-full object-cover" />
                }
                else
                {
                    @companionAvatar
                }
            </div>
            <div class="companion-info">
                <h2>@companionName</h2>
                <span class="mood-badge mood-@currentMood.ToString().ToLower()">@currentMood</span>
            </div>
        </div>
        <div class="header-right">
            <h3>Hi, @userName! 👋</h3>
            <button class="settings-button" @onclick="GoToSettings" title="Settings">⚙️</button>
        </div>
    </div>

    <div class="quick-actions">
        <button class="quick-action-btn" @onclick="() => ShowDialog(ActionType.Pronunciation)">
            <div class="action-icon">🗣️</div>
            <div class="action-text">How do I pronounce...?</div>
        </button>

        <button class="quick-action-btn" @onclick="() => ShowDialog(ActionType.Translation)">
            <div class="action-icon">🔄</div>
            <div class="action-text">How do I say...?</div>
        </button>

        <button class="quick-action-btn" @onclick="() => ShowDialog(ActionType.Meaning)">
            <div class="action-icon">💡</div>
            <div class="action-text">What does ... mean?</div>
        </button>

        <button class="quick-action-btn" @onclick="() => ShowDialog(ActionType.TextAnalysis)">
            <div class="action-icon">📖</div>
            <div class="action-text">Help me read something</div>
        </button>

        <button class="quick-action-btn skill-stats-btn" @onclick="OpenSkillStats">
            <div class="action-icon">📊</div>
            <div class="action-text">Track skill stats</div>
        </button>

        <button class="quick-action-btn conversation-btn" @onclick="StartConversation">
            <div class="action-icon">💬</div>
            <div class="action-text">Open chat</div>
        </button>
    </div>

    @if (showDialog)
    {
        <div class="dialog-overlay" @onclick="CloseDialog">
            <div class="dialog-content" @onclick:stopPropagation="true">
                <div class="flex items-center mb-4">
                    <h3 class="mb-0">@GetDialogTitle()</h3>
                    @if (SupportsHistory)
                    {
                        <button type="button" class="ml-auto p-2" @onclick="ToggleHistoryAsync" title="Show history" aria-label="Show history">
                            <i class="fa fa-history" aria-hidden="true"></i>
                        </button>
                    }
                </div>

                @if (currentAction == ActionType.TextAnalysis)
                {
                    <textarea @bind="inputText" @bind:event="oninput" placeholder="@GetPlaceholder()" rows="5" class="input-field"></textarea>
                }
                else
                {
                    <input type="text" @bind="inputText" @bind:event="oninput" placeholder="@GetPlaceholder()" class="input-field" />
                }

                @if (showHistory)
                {
                    <div class="mb-4 max-h-48 overflow-y-auto rounded-lg border border-gray-200 bg-gray-50 p-3">
                        @if (historyItems.Count == 0)
                        {
                            <p class="text-sm text-gray-500">No history yet.</p>
                        }
                        else
                        {
                            @foreach (var item in historyItems)
                            {
                                <div class="border-b border-gray-200 py-2 last:border-b-0">
                                    <div class="font-semibold">@item.OriginalText</div>
                                    <div class="text-sm text-gray-600">@item.Summary</div>
                                    <div class="text-xs text-gray-400">@item.UsedAt.ToLocalTime().ToString("g")</div>
                                </div>
                            }
                        }
                    </div>
                }

                <LoadingText IsLoading="@isLoading">
                    @if (!string.IsNullOrWhiteSpace(resultText) || canPlayAudio)
                    {
                        <div class="result-section">
                            @if ((currentAction == ActionType.TextAnalysis || currentAction == ActionType.Translation) && analysisChunks != null && analysisChunks.Any())
                            {
                                @if (selectedChunk != null)
                                {
                                    <div class="mb-3 p-3 bg-blue-50 rounded-lg border border-blue-200">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                                <h6 class="text-blue-800 fw-semibold mb-0"
                                                    @onclick="(e) => OnChunkWordClick(selectedChunk.Word, e)"
                                                    @onclick:stopPropagation="true"
                                                    style="cursor: pointer;">@selectedChunk.Word</h6>
                                            </div>
                                            <button type="button" class="btn-close btn-sm"
                                                    @onclick="ClearSelectedChunk"
                                                    @onclick:stopPropagation="true"></button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(selectedChunk.Translation))
                                        {
                                            <div class="mb-2">
                                                <span class="text-success fw-bold">🔤 @selectedChunk.Translation</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(selectedChunk.Note))
                                        {
                                            <div class="p-2 bg-white rounded border border-blue-100">
                                                <small class="text-muted">💡 @selectedChunk.Note</small>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="p-3 bg-gray-50 rounded-lg border border-gray-300">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var chunk in analysisChunks)
                                        {
                                            <span @onclick="async (e) => await OnChunkBlockClick(chunk, e)"
                                                  @onclick:stopPropagation="true"
                                                  class="@GetChunkBlockClass(chunk)"
                                                  style="cursor: pointer;">@chunk.Word</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="result-text">@resultText</div>
                                @if (!string.IsNullOrWhiteSpace(contextText))
                                {
                                    <div class="context-text">@contextText</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(exampleText))
                                {
                                    <div class="example-text">💭 @exampleText</div>
                                }
                            }

                            @if (canPlayAudio && currentAction != ActionType.TextAnalysis)
                            {
                                <ButtonSecondary OnClick="PlayAudio" Class="block mx-auto">
                                    <i class="fa fa-play" aria-label="Play pronunciation" title="Play pronunciation"></i>
                                </ButtonSecondary>
                            }
                        </div>
                    }
                </LoadingText>

                <div class="dialog-buttons">
                    <ButtonSecondary OnClick="CloseDialog">Close</ButtonSecondary>
                    <ButtonPrimary OnClick="ProcessAction" Disabled="@(string.IsNullOrWhiteSpace(inputText) || isLoading)">
                        Go
                    </ButtonPrimary>
                </div>
            </div>
        </div>
    }

    <DefinitionTooltip IsVisible="@showDefinitionTooltip"
                       IsLoading="@isLoadingDefinition"
                       DefinitionResult="@definitionResult"
                       X="@tooltipX"
                       Y="@tooltipY"
                       OnClose="@CloseDefinitionTooltip" />
</div>

@code {
    private string userName = "Friend";
    private string companionName = "Luna";
    private string companionAvatar = string.Empty;
    private string? companionAvatarImagePath;
    private CompanionMood currentMood = CompanionMood.Curious;

    private bool showDialog = false;
    private ActionType currentAction;
    private string inputText = string.Empty;
    private string resultText = string.Empty;
    private string contextText = string.Empty;
    private string exampleText = string.Empty;
    private bool isLoading = false;
    private bool canPlayAudio = false;
    private byte[] audioData = Array.Empty<byte>();
    private List<TextChunk>? analysisChunks = null;
    private TextChunk? selectedChunk = null;
    private int userProfileId;
    private bool showHistory;
    private List<QuickActionHistoryItem> historyItems = new();

    private string targetLanguage = "es";
    private string nativeLanguage = "en";

    private bool showDefinitionTooltip = false;
    private bool isLoadingDefinition = false;
    private DefinitionResult? definitionResult = null;
    private double tooltipX = 0;
    private double tooltipY = 0;
    private string currentDefinitionWord = string.Empty;

    enum ActionType
    {
        Pronunciation,
        Translation,
        Meaning,
        TextAnalysis
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userProfile = await OnboardingService.GetCurrentUserProfileAsync();
            if (userProfile != null)
            {
                userProfileId = userProfile.Id;
                userName = userProfile.Name;
                targetLanguage = userProfile.TargetLanguage;
                nativeLanguage = userProfile.NativeLanguage;
            }

            var companion = await OnboardingService.GetOrCreateCompanionAsync();
            companionName = companion.Name;
            companionAvatar = companion.Avatar;
            companionAvatarImagePath = GetCompanionAvatarImagePath(companionName);
            currentMood = companion.CurrentMood;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
        }
    }

    private void ShowDialog(ActionType action)
    {
        currentAction = action;
        showDialog = true;
        inputText = string.Empty;
        resultText = string.Empty;
        contextText = string.Empty;
        exampleText = string.Empty;
        canPlayAudio = false;
        audioData = Array.Empty<byte>();
        analysisChunks = null;
        selectedChunk = null;
        showHistory = false;
        historyItems.Clear();
    }

    private void CloseDialog()
    {
        showDialog = false;
    }

    private string GetDialogTitle()
    {
        return currentAction switch
        {
            ActionType.Pronunciation => "How do I pronounce...?",
            ActionType.Translation => "How do I say...?",
            ActionType.Meaning => "What does this mean?",
            ActionType.TextAnalysis => "Help me read this",
            _ => ""
        };
    }

    private string GetPlaceholder()
    {
        return currentAction switch
        {
            ActionType.Pronunciation => $"Enter text in {targetLanguage}...",
            ActionType.Translation => $"Enter text in {nativeLanguage}...",
            ActionType.Meaning => $"Enter word/phrase in {targetLanguage}...",
            ActionType.TextAnalysis => "Paste text to analyze...",
            _ => "Enter text..."
        };
    }

    private async Task ProcessAction()
    {
        try
        {
            isLoading = true;
            resultText = string.Empty;
            contextText = string.Empty;
            exampleText = string.Empty;
            canPlayAudio = false;
            audioData = Array.Empty<byte>();
            analysisChunks = null;
            selectedChunk = null;

            switch (currentAction)
            {
                case ActionType.Pronunciation:
                    var pronResult = await QuickActionsService.GetPronunciationAsync(inputText, targetLanguage);
                    if (pronResult.Success)
                    {
                        audioData = pronResult.AudioData;
                        canPlayAudio = audioData.Length > 0;
                    }
                    else
                    {
                        resultText = pronResult.ErrorMessage;
                    }
                    break;

                case ActionType.Translation:
                    var transResult = await QuickActionsService.TranslateAsync(inputText, nativeLanguage, targetLanguage);
                    if (transResult.Success)
                    {
                        resultText = transResult.TranslatedText;
                        analysisChunks = transResult.Chunks;
                        audioData = transResult.AudioData;
                        canPlayAudio = audioData.Length > 0;
                        await SaveHistoryAsync(transResult.OriginalText, transResult.TranslatedText);
                    }
                    else
                    {
                        resultText = transResult.ErrorMessage;
                    }
                    break;

                case ActionType.Meaning:
                    var meaningResult = await QuickActionsService.GetMeaningAsync(inputText, targetLanguage, nativeLanguage);
                    if (meaningResult.Success)
                    {
                        resultText = meaningResult.Translation;
                        contextText = meaningResult.Context;
                        exampleText = meaningResult.Example;
                    }
                    else
                    {
                        resultText = meaningResult.ErrorMessage;
                    }
                    break;

                case ActionType.TextAnalysis:
                    var analysisResult = await QuickActionsService.AnalyzeTextAsync(inputText, targetLanguage);
                    if (analysisResult.Success)
                    {
                        analysisChunks = analysisResult.Chunks;
                        resultText = "Analysis complete!";
                        await SaveHistoryAsync(
                            analysisResult.OriginalText,
                            string.Join(", ", analysisResult.Chunks.Take(5).Select(chunk => $"{chunk.Word} ({chunk.Translation})")));
                    }
                    else
                    {
                        resultText = analysisResult.ErrorMessage;
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            resultText = "An error occurred. Please try again.";
            Console.WriteLine($"Error processing action: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task PlayAudio() => PlayVoiceClip(audioData);

    private bool SupportsHistory => currentAction is ActionType.Translation or ActionType.TextAnalysis;

    private async Task ToggleHistoryAsync()
    {
        showHistory = !showHistory;
        if (showHistory && userProfileId > 0)
        {
            historyItems = await QuickActionsService.GetHistoryAsync(userProfileId, currentAction.ToString());
        }
    }

    private Task SaveHistoryAsync(string originalText, string summary)
    {
        if (userProfileId == 0)
            return Task.CompletedTask;

        return QuickActionsService.AddHistoryAsync(userProfileId, currentAction.ToString(), originalText, summary);
    }

    private async Task OnChunkBlockClick(TextChunk chunk, MouseEventArgs e)
    {
        if (selectedChunk?.Word == chunk.Word)
        {
            selectedChunk = null;
            showDefinitionTooltip = false;
            StateHasChanged();
        }
        else
        {
            selectedChunk = chunk;
            await OnChunkWordClick(chunk.Word, e);
        }
    }

    private void ClearSelectedChunk()
    {
        selectedChunk = null;
    }

    private string GetChunkBlockClass(TextChunk chunk)
    {
        const string baseClasses = "px-2 py-1 rounded transition-all";
        if (selectedChunk?.Word == chunk.Word)
            return $"{baseClasses} bg-indigo-600 text-white fw-semibold shadow";
        if (!string.IsNullOrWhiteSpace(chunk.Note))
            return $"{baseClasses} bg-yellow-100 border border-yellow-400 hover:bg-yellow-200 hover:border-yellow-500";
        return $"{baseClasses} bg-white border border-gray-300 hover:bg-indigo-100 hover:border-indigo-400";
    }

    private async Task OnChunkWordClick(string word, MouseEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(word))
            return;

        tooltipX = e.ClientX;
        tooltipY = e.ClientY;

        if (currentDefinitionWord == word && definitionResult != null)
        {
            showDefinitionTooltip = !showDefinitionTooltip;
            StateHasChanged();
            return;
        }

        currentDefinitionWord = word;
        showDefinitionTooltip = true;
        isLoadingDefinition = true;
        definitionResult = null;
        StateHasChanged();

        try
        {
            if (LanguageServiceFactory.TryGetLanguageService(targetLanguage, out var languageService))
            {
                var provider = languageService!.GetDefinitionProviders().FirstOrDefault();
                if (provider != null)
                {
                    definitionResult = await provider.GetDefinitionsAsync(word);
                }
            }

            definitionResult ??= new DefinitionResult
            {
                Word = word,
                ProviderName = "N/A",
                Entries = new List<DefinitionEntry>()
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading definition for '{word}': {ex.Message}");
            definitionResult = new DefinitionResult
            {
                Word = word,
                ProviderName = "Error",
                Entries = new List<DefinitionEntry>()
            };
        }
        finally
        {
            isLoadingDefinition = false;
            StateHasChanged();
        }
    }

    private void CloseDefinitionTooltip()
    {
        showDefinitionTooltip = false;
        selectedChunk = null;
        StateHasChanged();
    }

    private void StartConversation()
    {
        Navigation.NavigateTo("/chat");
    }

    private void OpenSkillStats()
    {
        Navigation.NavigateTo("/skills");
    }

    private void GoToSettings()
    {
        Navigation.NavigateTo("/settings");
    }

    private static string? GetCompanionAvatarImagePath(string name) => name?.Trim().ToLowerInvariant() switch
    {
        "blip" => "assets/blip.jpeg",
        _ => null
    };
}
