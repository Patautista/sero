@page "/chat"
@using MauiApp2.Features.Chat
@using MauiApp2.Features.Onboarding
@using MauiApp2.Components
@using MauiApp2.Services
@using MauiApp2.Services.AI
@using MauiApp2.Services.Audio
@using MauiApp1.Services.Cache
@using Domain.Shared.Models
@using Microsoft.AspNetCore.Components.Web
@using Business.Interfaces
@using Infrastructure.Factories
@using Microsoft.Extensions.AI
@using Microsoft.Extensions.Logging
@inherits SharedBaseComponent
@inject ChatService ChatService
@inject OnboardingService OnboardingService
@inject IApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.AI.IChatClient ChatClient
@inject Microsoft.Extensions.Logging.ILogger<ChatPage> Logger
@inject AiDefinitionCache AiDefinitionCache
@inject ICompanionPromptBuilder PromptBuilder

<div class="chat-container">
    <div class="chat-header">
        <button class="back-button" @onclick="GoBack">←</button>
        <div class="companion-info">
            <div class="companion-avatar-small">
                @if (!string.IsNullOrEmpty(companionAvatarImagePath))
                {
                    <img src="@companionAvatarImagePath" alt="@companionName" class="companion-avatar-photo" />
                }
                else
                {
                    @companionAvatar
                }
            </div>
            <div>
                <h3>@companionName</h3>
                <span class="mood-indicator mood-@currentMood.ToString().ToLower()">@currentMood</span>
            </div>
        </div>
        <button class="bookmarks-toggle ml-auto" @onclick="ToggleBookmarksList" aria-expanded="@showBookmarks" aria-label="Show bookmarked messages">
            <i class="fa fa-bookmark" aria-hidden="true"></i>
        </button>
    </div>

    @if (showBookmarks)
    {
        <div class="bookmarks-panel" aria-label="Bookmarked messages">
            @if (bookmarkedMessages.Count == 0)
            {
                <p>No bookmarked messages yet.</p>
            }
            @foreach (var bookmark in bookmarkedMessages)
            {
                <button class="bookmark-list-item" @key="bookmark.Id" @onclick="() => JumpToBookmarkAsync(bookmark.Id)">
                    <span>@bookmark.Timestamp.ToLocalTime().ToString("g")</span>
                    <span>@(bookmark.MessageType == MessageType.AudioMessage ? "🔊 Audio message" : bookmark.Content)</span>
                </button>
            }
        </div>
    }

    <div class="chat-messages" @ref="messageContainer" @onpointerup="HandleSelectionAsync">
        <LoadingSpinner IsLoading="@isLoading">
            @if (!isShowingLatest)
            {
                <button class="chat-history-button" @onclick="ReturnToLatestAsync">↓ Back to latest</button>
            }
            @if (hasOlderMessages)
            {
                <button class="chat-history-button" @onclick="LoadOlderMessagesAsync" disabled="@isLoadingOlder">@(isLoadingOlder ? "Loading..." : "↑ Load older messages")</button>
            }
            @if (messages.Any())
            {
                @foreach (var message in messages)
                {
                    <div class="chat-entry @(highlightedMessageId == message.Id ? "bookmark-highlight" : "") @(contextMenuMessageId == message.Id ? "context-menu-active" : "")"
                         id="chat-message-@message.Id" @key="message.Id"
                         @oncontextmenu="@(e => OpenMessageContextMenu(message.Id, e))" @oncontextmenu:preventDefault="true"
                         @onpointerdown="@(e => OnMessagePointerDown(message.Id, e))"
                         @onpointerup="CancelLongPress" @onpointerleave="CancelLongPress" @onpointercancel="CancelLongPress">
                    @if (message.MessageType == MessageType.SkillUpdate
                        || message.MessageType == MessageType.UserInsight
                        || message.MessageType == MessageType.CompanionInsight)
                    {
                        <div class="skill-update-wrapper">
                            <div class="skill-update-message @GetSystemNoticeClass(message.MessageType)">@message.Content</div>
                        </div>
                    }
                    else if (message.MessageType == MessageType.AudioMessage)
                    {
                        <div class="message-wrapper companion-message-wrapper">
                            <div class="message message-companion message-audio">
                                <button class="audio-widget @(playingAudioMessageId == message.Id ? "playing" : "")"
                                        disabled="@(loadingAudioMessageId == message.Id)"
                                        @onclick="() => PlayAudioMessage(message)">
                                    <span class="audio-widget-icon">
                                        @(loadingAudioMessageId == message.Id ? "⏳" : playingAudioMessageId == message.Id ? "⏸" : "▶")
                                    </span>
                                    <span class="audio-widget-waveform">🔊 Listen</span>
                                </button>
                                <div class="message-time">@message.Timestamp.ToLocalTime().ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="message-wrapper @(message.SenderType == SenderType.User ? "user-message-wrapper" : "companion-message-wrapper")">
                            <div class="message @(message.SenderType == SenderType.User ? "message-user" : message.MessageType == MessageType.ActivityPrompt ? "message-activity-prompt" : "message-companion")">
                                @if (message.MessageType == MessageType.ActivityPrompt)
                                {
                                    <div class="activity-prompt-badge">📝 Activity Prompt</div>
                                }
                                <div class="message-content">@((MarkupString)SimpleMarkdown.ToHtml(message.Content))</div>
                                <div class="message-time">@message.Timestamp.ToLocalTime().ToString("HH:mm")</div>

                                @if (message.ShowTranslation && !string.IsNullOrWhiteSpace(message.Translation))
                                {
                                    <div class="message-translation">🌐 @message.Translation</div>
                                }

                                @if (message.Corrections != null && message.Corrections.Any())
                                {
                                    <div class="corrections-section">
                                        <div class="corrections-header">💡 Corrections:</div>
                                        @foreach (var correction in message.Corrections)
                                        {
                                            <div class="correction-item">
                                                <span class="correction-original">@correction.Original</span>
                                                <span class="correction-arrow">→</span>
                                                <span class="correction-corrected">@correction.Corrected</span>
                                                @if (!string.IsNullOrWhiteSpace(correction.Explanation))
                                                {
                                                    <div class="correction-explanation">@correction.Explanation</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (message.SenderType == SenderType.Companion)
                            {
                                <div class="message-actions">
                                    <button class="tts-button" @onclick="() => PlayMessageAudio(message)" title="Listen">🔊</button>
                                    <button class="translate-button @(message.ShowTranslation ? "active" : "")" @onclick="() => TranslateMessage(message)" title="Translate" disabled="@message.IsTranslating">
                                        @(message.IsTranslating ? "⏳" : "🌐")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">💬</div>
                    <p>Start a conversation with @companionName!</p>
                </div>
            }

            @if (isTyping)
            {
                <div class="message-wrapper companion-message-wrapper">
                    <div class="typing-bubble">
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                        <span class="typing-dot"></span>
                    </div>
                </div>
            }
        </LoadingSpinner>
    </div>

    <div class="chat-input-container">
        <textarea 
            @bind="messageInput" 
            @bind:event="oninput"
            @onkeydown="HandleKeyDown"
            placeholder="Type your message..."
            rows="1"
            class="chat-input"
            disabled="@isSending">
        </textarea>
        <button class="send-button" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(messageInput) || isSending)">
            ➤
        </button>
    </div>

    <DefinitionTooltip IsVisible="@showDefinitionTooltip"
                       IsLoading="@isLoadingDefinition"
                       DefinitionResult="@definitionResult"
                       X="@tooltipX"
                       Y="@tooltipY"
                       OnClose="@CloseDefinitionTooltip" />

    @if (contextMenuMessageId is { } contextMessageId)
    {
        var contextMessage = messages.FirstOrDefault(m => m.Id == contextMessageId);
        if (contextMessage != null)
        {
            <div class="message-context-menu-backdrop" @onclick="HandleContextMenuBackdropClick" @oncontextmenu="CloseMessageContextMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="message-context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;">
                <button class="message-context-menu-item" @onclick="() => ToggleBookmarkAsync(contextMessage)">
                    @(contextMessage.IsBookmarked ? "🔖 Remove bookmark" : "🔖 Bookmark")
                </button>
            </div>
        }
    }
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="error-toast">@errorMessage</div>
}

@code {
    private ElementReference messageContainer;
    private List<ChatMessage> messages = new();
    private List<ChatMessage> bookmarkedMessages = new();
    private bool showBookmarks;
    private int? contextMenuMessageId;
    private double contextMenuX;
    private double contextMenuY;
    private CancellationTokenSource? longPressCts;
    private DateTimeOffset? longPressMenuOpenedAt;
    private int? highlightedMessageId;
    private int? pendingScrollMessageId;
    private bool isShowingLatest = true;
    private bool hasOlderMessages;
    private bool isLoadingOlder;
    private bool pendingRestoreScroll;
    private bool pendingScrollBottom;
    private string messageInput = string.Empty;
    private bool isLoading = true;
    private bool isSending = false;
    private bool isTyping = false;
    private string errorMessage = string.Empty;
    private int conversationId;
    private string companionName = string.Empty;
    private string companionAvatar = string.Empty;
    private string? companionAvatarImagePath;
    private CompanionMood currentMood = CompanionMood.Curious;
    private int userProfileId;
    private string targetLanguage = string.Empty;

    private bool showDefinitionTooltip = false;
    private bool isLoadingDefinition = false;
    private DefinitionResult? definitionResult = null;
    private double tooltipX = 0;
    private double tooltipY = 0;
    private string currentDefinitionWord = string.Empty;
    private string nativeLanguage = string.Empty;
    private readonly Random _random = new();
    private int? playingAudioMessageId;
    private int? loadingAudioMessageId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get user profile
            var userProfile = await OnboardingService.GetCurrentUserProfileAsync();
            if (userProfile is null)
            {
                Navigation.NavigateTo("/onboarding");
                return;
            }

            userProfileId = userProfile.Id;
            targetLanguage = userProfile.TargetLanguage;
            nativeLanguage = userProfile.NativeLanguage;

            // Get companion
            var companion = await OnboardingService.GetOrCreateCompanionAsync();
            companionName = companion.Name;
            companionAvatar = companion.Avatar;
            companionAvatarImagePath = GetCompanionAvatarImagePath(companionName);
            currentMood = companion.CurrentMood;

            // Load conversation
            var conversation = await ChatService.GetOrCreateActiveConversationAsync(userProfileId);
            conversationId = conversation.ConversationId;
            messages = conversation.Messages;
            hasOlderMessages = conversation.HasOlderMessages;

            isLoading = false;
            pendingScrollBottom = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load conversation";
            Console.WriteLine($"Error loading chat: {ex.Message}");
            isLoading = false;
        }
    }

    private void OpenMessageContextMenu(int messageId, MouseEventArgs e)
    {
        longPressCts?.Cancel();
        contextMenuMessageId = messageId;
        contextMenuX = e.ClientX;
        contextMenuY = e.ClientY;
    }

    private void CloseMessageContextMenu()
    {
        contextMenuMessageId = null;
        longPressMenuOpenedAt = null;
    }

    private void HandleContextMenuBackdropClick()
    {
        if (longPressMenuOpenedAt is { } openedAt
            && DateTimeOffset.UtcNow - openedAt < TimeSpan.FromMilliseconds(750))
        {
            return;
        }

        CloseMessageContextMenu();
    }

    private void OnMessagePointerDown(int messageId, PointerEventArgs e)
    {
        if (e.PointerType != "touch")
            return;

        longPressCts?.Cancel();
        var cts = new CancellationTokenSource();
        longPressCts = cts;
        _ = StartLongPressAsync(messageId, e.ClientX, e.ClientY, cts);
    }

    private async Task StartLongPressAsync(int messageId, double x, double y, CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(500, cts.Token);
            contextMenuMessageId = messageId;
            contextMenuX = x;
            contextMenuY = y;
            longPressMenuOpenedAt = DateTimeOffset.UtcNow;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void CancelLongPress()
    {
        longPressCts?.Cancel();
    }

    private async Task ToggleBookmarksList()
    {
        showBookmarks = !showBookmarks;
        contextMenuMessageId = null;
        if (showBookmarks)
            bookmarkedMessages = await ChatService.GetBookmarkedMessagesAsync(conversationId);
    }

    private async Task ToggleBookmarkAsync(ChatMessage message)
    {
        try
        {
            var bookmarked = !message.IsBookmarked;
            if (await ChatService.SetBookmarkAsync(conversationId, message.Id, bookmarked))
            {
                message.IsBookmarked = bookmarked;
                if (showBookmarks)
                    bookmarkedMessages = await ChatService.GetBookmarkedMessagesAsync(conversationId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not update bookmark for message {MessageId}", message.Id);
            errorMessage = "Could not update bookmark";
        }
        finally
        {
            contextMenuMessageId = null;
        }
    }

    private async Task JumpToBookmarkAsync(int messageId)
    {
        try
        {
            var page = await ChatService.LoadMessagePageAsync(conversationId, messageId);
            if (!page.Messages.Any(message => message.Id == messageId))
            {
                errorMessage = "Bookmarked message not found";
                return;
            }

            messages = page.Messages;
            hasOlderMessages = page.HasOlder;
            isShowingLatest = false;
            highlightedMessageId = messageId;
            pendingScrollMessageId = messageId;
            showBookmarks = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not open bookmarked message {MessageId}", messageId);
            errorMessage = "Could not open bookmarked message";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScrollMessageId is { } messageId)
        {
            pendingScrollMessageId = null;
            await JSRuntime.InvokeVoidAsync("chatScroll.scrollToMessage", messageContainer, messageId);
        }
        else if (pendingRestoreScroll)
        {
            pendingRestoreScroll = false;
            await JSRuntime.InvokeVoidAsync("chatScroll.restorePosition", messageContainer);
        }
        else if (pendingScrollBottom)
        {
            pendingScrollBottom = false;
            await JSRuntime.InvokeVoidAsync("chatScroll.scrollToBottom", messageContainer);
        }
    }

    private async Task LoadOlderMessagesAsync()
    {
        if (isLoadingOlder || !hasOlderMessages || messages.Count == 0)
            return;

        isLoadingOlder = true;
        try
        {
            var page = await ChatService.LoadMessagePageAsync(conversationId, messages[0].Id - 1);
            await JSRuntime.InvokeVoidAsync("chatScroll.rememberPosition", messageContainer);
            messages.InsertRange(0, page.Messages);
            hasOlderMessages = page.HasOlder;
            pendingRestoreScroll = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load older messages");
            errorMessage = "Could not load older messages";
        }
        finally
        {
            isLoadingOlder = false;
        }
    }

    private async Task ReturnToLatestAsync()
    {
        var page = await ChatService.LoadMessagePageAsync(conversationId);
        messages = page.Messages;
        hasOlderMessages = page.HasOlder;
        isShowingLatest = true;
        highlightedMessageId = null;
        pendingScrollBottom = true;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageInput) || isSending)
            return;

        isSending = true;
        errorMessage = string.Empty;
        var content = messageInput.Trim();
        messageInput = string.Empty;

        try
        {
            // 1. Save and immediately display user message
            var userMessage = await ChatService.SaveUserMessageAsync(conversationId, content);
            var latestPage = await ChatService.LoadMessagePageAsync(conversationId);
            messages = latestPage.Messages;
            hasOlderMessages = latestPage.HasOlder;
            isShowingLatest = true;
            highlightedMessageId = null;
            userMessage = messages.First(message => message.Id == userMessage.Id);
            isTyping = true;
            StateHasChanged();
            await ScrollToBottom();

            // 2. Minimum natural typing delay (1.5–3.5 s) so the animation is never instant
            var minDelayTask = Task.Delay(_random.Next(1500, 3500));

            // 3. Corrections: separate API call — display on user bubble as soon as they arrive
            var correctionCheck = await ChatService.GetCorrectionsAsync(conversationId, content, targetLanguage, nativeLanguage);
            var corrections = correctionCheck.Corrections;
            if (corrections != null && corrections.Any())
            {
                userMessage.Corrections = corrections;
                StateHasChanged();
                _ = ChatService.PersistUserMessageCorrectionsAsync(userMessage.Id, corrections);
            }

            // 4. Generate companion response (can use corrections for context)
            var companionTask = ChatService.GenerateCompanionMessageAsync(
                conversationId,
                userMessage.Id,
                correctionCheck.Corrections,
                correctionCheck.NewlyMasteredConcepts);

            // 5. Reveal paragraphs progressively once both delay and response are ready
            await Task.WhenAll(minDelayTask, companionTask);
            var companions = await companionTask;

            isTyping = false;
            for (int i = 0; i < companions.Count; i++)
            {
                messages.Add(companions[i]);
                if (messages.Count > ChatService.MessagePageSize)
                {
                    messages.RemoveAt(0);
                    hasOlderMessages = true;
                }
                StateHasChanged();
                await ScrollToBottom();

                if (i < companions.Count - 1)
                {
                    // Let the user read the current paragraph before typing starts
                    await Task.Delay(Math.Clamp(companions[i].Content.Length * 25, 400, 900));
                    isTyping = true;
                    StateHasChanged();
                    // Typing duration proportional to the next paragraph's length
                    await Task.Delay(Math.Clamp(companions[i + 1].Content.Length * 35, 600, 2200));
                    isTyping = false;
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to send message";
            isTyping = false;
            messageInput = content;
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task TranslateMessage(ChatMessage message)
    {
        if (message.IsTranslating) return;

        // Toggle off if already showing
        if (message.ShowTranslation)
        {
            message.ShowTranslation = false;
            StateHasChanged();
            return;
        }

        // Fetch translation if not yet cached
        if (message.Translation == null)
        {
            message.IsTranslating = true;
            StateHasChanged();
            try
            {
                message.Translation = await ApiService.TranslateAsync(message.Content, targetLanguage, nativeLanguage);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error translating: {ex.Message}");
                message.Translation = "[Translation unavailable]";
            }
            finally
            {
                message.IsTranslating = false;
            }
        }

        message.ShowTranslation = true;
        StateHasChanged();
    }

    private Task PlayMessageAudio(ChatMessage message) => PlayVoiceClip(message.Content, targetLanguage);

    private async Task PlayAudioMessage(ChatMessage message)
    {
        if (loadingAudioMessageId == message.Id) return;

        loadingAudioMessageId = message.Id;
        StateHasChanged();
        try
        {
            await PlayVoiceClip(message.Content, targetLanguage);
            playingAudioMessageId = message.Id;
        }
        finally
        {
            loadingAudioMessageId = null;
            StateHasChanged();
        }
    }

    private Task ScrollToBottom()
    {
        pendingScrollBottom = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleSelectionAsync(PointerEventArgs e)
    {
        var selectedText = await JSRuntime.InvokeAsync<string>("selectionHelper.getSelectedText");
        if (string.IsNullOrWhiteSpace(selectedText))
            return;

        var tokens = selectedText.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        // If more than 1 token, translate instead of showing definition
        if (tokens.Length > 1)
        {
            await HandleMultiTokenTranslationAsync(selectedText, e);
            return;
        }

        // Single token: show definition (with up to 5 words for context)
        if (tokens.Length > 5)
            return;

        if (currentDefinitionWord == selectedText && definitionResult != null)
        {
            tooltipX = e.ClientX;
            tooltipY = e.ClientY;
            showDefinitionTooltip = !showDefinitionTooltip;
            StateHasChanged();
            return;
        }

        tooltipX = e.ClientX;
        tooltipY = e.ClientY;
        currentDefinitionWord = selectedText;
        showDefinitionTooltip = true;
        isLoadingDefinition = true;
        definitionResult = null;
        StateHasChanged();

        try
        {
            if (LanguageServiceFactory.TryGetLanguageService(targetLanguage, out var languageService))
            {
                var provider = languageService!.GetDefinitionProviders().FirstOrDefault();
                if (provider != null)
                    definitionResult = await provider.GetDefinitionsAsync(selectedText);
            }

            // If no definition found, use AI provider as fallback
            if (definitionResult?.Entries == null || !definitionResult.Entries.Any())
            {
                var aiHelper = new AiDefinitionHelper(ChatClient, Logger, AiDefinitionCache, PromptBuilder);
                definitionResult = await aiHelper.GenerateDefinitionAsync(selectedText, targetLanguage, nativeLanguage);
            }

            definitionResult ??= new DefinitionResult
            {
                Word = selectedText,
                ProviderName = "N/A",
                Entries = new List<DefinitionEntry>()
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading definition for '{selectedText}': {ex.Message}");
            Logger.LogError(ex, "Error loading definition for '{Word}'", selectedText);
            definitionResult = new DefinitionResult
            {
                Word = selectedText,
                ProviderName = "Error",
                Entries = new List<DefinitionEntry>()
            };
        }
        finally
        {
            isLoadingDefinition = false;
            StateHasChanged();
        }
    }

    private async Task HandleMultiTokenTranslationAsync(string selectedText, PointerEventArgs e)
    {
        showDefinitionTooltip = false;
        currentDefinitionWord = string.Empty;
        StateHasChanged();

        try
        {
            // Translate multi-token selection
            var translation = await ApiService.TranslateAsync(selectedText, targetLanguage, nativeLanguage);

            if (!string.IsNullOrWhiteSpace(translation))
            {
                // Show translation in a simple notification/toast or update the tooltip to show translation
                definitionResult = new DefinitionResult
                {
                    Word = selectedText,
                    ProviderName = "🌐 Translation",
                    Entries = new List<DefinitionEntry>
                    {
                        new DefinitionEntry
                        {
                            Headword = selectedText,
                            Meanings = new List<DefinitionMeaning>
                            {
                                new DefinitionMeaning
                                {
                                    Definition = selectedText,
                                    DefinitionLanguage = targetLanguage,
                                    Translation = translation,
                                    TranslationLanguage = nativeLanguage,
                                    Examples = new List<string>()
                                }
                            }
                        }
                    }
                };

                tooltipX = e.ClientX;
                tooltipY = e.ClientY;
                showDefinitionTooltip = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error translating text: {ex.Message}");
            Logger.LogError(ex, "Error translating selected text");
        }
    }

    private void CloseDefinitionTooltip()
    {
        showDefinitionTooltip = false;
        currentDefinitionWord = string.Empty;
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/home");
    }

    // Maps a system-notice message type to its colored pill variant so skill updates,
    // "learned about you" and "learned about companion" notices are visually distinct.
    private static string GetSystemNoticeClass(MessageType messageType) => messageType switch
    {
        MessageType.UserInsight => "notice-user-insight",
        MessageType.CompanionInsight => "notice-companion-insight",
        _ => "notice-skill-update"
    };

    // Maps known companions to their static portrait asset, falling back to the emoji avatar.
    private static string? GetCompanionAvatarImagePath(string name) => name?.Trim().ToLowerInvariant() switch
    {
        "blip" => "assets/blip.jpeg",
        _ => null
    };
}
