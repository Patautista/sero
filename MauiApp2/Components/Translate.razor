@using MauiApp2.Services
<span>@_translated</span>
@inject IApiService ApiService

@code {
    [Parameter] public string Text { get; set; }
    [Parameter] public string Lang { get; set; } = "pt";

    private string _translated;

    protected override async Task OnInitializedAsync()
    {
        // TODO: Use values from settings or user preferences for the target language
        _translated = await ApiService.TranslateAsync(Text, Lang, "en");
        StateHasChanged(); // força re-render quando a tradução chega
    }
}
